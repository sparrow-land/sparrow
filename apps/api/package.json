{
  "name": "@sparrow/api",
  "version": "0.1.0",
  "description": "Fastify server for sparrow.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "sparrow-api": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bundle-clients": "node scripts/bundle-clients.mjs"
  },
  "dependencies": {
    "@sparrow/common-types": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.12.0",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sparrow/client": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
